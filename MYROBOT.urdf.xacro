<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro"
       name="myrobot">
    <xacro:include filename="../sensors/lidar.xacro"/>
    <!-- ========================= -->
    <!-- Robot dimensions -->
    <!-- ========================= -->

    <xacro:property name="body_length" value="0.30"/>
    <xacro:property name="body_width"  value="0.22"/>
    <xacro:property name="body_height" value="0.10"/>

    <xacro:property name="wheel_radius" value="0.033"/>
    <xacro:property name="wheel_width"  value="0.020"/>
    <xacro:property name="wheel_separation" value="0.20"/>


    <!-- ========================= -->
    <!-- Base -->
    <!-- ========================= -->


    <link name="base_link">

        <visual>
            <origin
                xyz="0 0 ${wheel_radius + body_height/2}"
                rpy="0 0 0"/>

            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>

            <material name="red">
                <color rgba="1 0 0 1"/>
            </material>
        </visual>

        <collision>
            <origin
                xyz="0 0 ${wheel_radius + body_height/2}"
                rpy="0 0 0"/>
            <geometry>
                <box size="${body_length} ${body_width} ${body_height}"/>
            </geometry>
        </collision>

        <inertial>
            <origin
                xyz="0 0 ${wheel_radius + body_height/2}"
                rpy="0 0 0"/>
            <mass value="1.0"/>

            <inertia
                ixx="0.01"
                ixy="0.0"
                ixz="0.0"
                iyy="0.01"
                iyz="0.0"
                izz="0.01"/>
        </inertial>

    </link>

    <!-- Gazebo-specific appearance -->
    <gazebo reference="base_link">
        <visual>
            <material>
                <ambient>1 0 0 1</ambient>
                <diffuse>1 0 0 1</diffuse>
                <specular>1 0 0 1</specular>
            </material>
        </visual>
    </gazebo>


    <!-- ========================= -->
    <!-- Left wheel -->
    <!-- ========================= -->

    <link name="left_wheel">
        <visual>
            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>
            <material name="wheel_red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>
            
        </visual>
        

        <collision>
            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>
        </collision>

        <inertial>
            <mass value="0.1"/>

            <inertia
                ixx="0.0001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0001"
                iyz="0.0"
                izz="0.0001"/>
        </inertial>

    </link>
    <gazebo reference="left_wheel">
        <visual>
            <material>
                <ambient>0.05 0.05 0.05 1</ambient>
                <diffuse>0.05 0.05 0.05 1</diffuse>
                <specular>0.05 0.05 0.05 1</specular>
            </material>
        </visual>
    </gazebo>

    <!-- ========================= -->
    <!-- Right wheel -->
    <!-- ========================= -->

    <link name="right_wheel">

        <visual>
            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>

            <material name="wheel_red">
                <color rgba="1.0 0.0 0.0 1.0"/>
            </material>

        </visual>


        <collision>
            <geometry>
                <cylinder
                    radius="${wheel_radius}"
                    length="${wheel_width}"/>
            </geometry>

            <origin
                xyz="0 0 0"
                rpy="${pi/2} 0 0"/>
        </collision>

        <inertial>
            <mass value="0.1"/>

            <inertia
                ixx="0.0001"
                ixy="0.0"
                ixz="0.0"
                iyy="0.0001"
                iyz="0.0"
                izz="0.0001"/>
        </inertial>

    </link>
    <gazebo reference="right_wheel">
        <visual>
            <material>
                <ambient>0.05 0.05 0.05 1</ambient>
                <diffuse>0.05 0.05 0.05 1</diffuse>
                <specular>0.05 0.05 0.05 1</specular>
            </material>
        </visual>
    </gazebo>

<!-- ========================= -->
<!-- Front caster -->
<!-- ========================= -->

<link name="caster_wheel">

    <visual>
        <geometry>
            <sphere radius="0.015"/>
        </geometry>

        <material name="caster_black">
            <color rgba="0.05 0.05 0.05 1"/>
        </material>
    </visual>

    <collision>
        <geometry>
            <sphere radius="0.015"/>
        </geometry>
    </collision>

    <inertial>
        <mass value="0.05"/>

        <inertia
            ixx="0.00001"
            ixy="0.0"
            ixz="0.0"
            iyy="0.00001"
            iyz="0.0"
            izz="0.00001"/>
    </inertial>

</link>


    <!-- ========================= -->
    <!-- Left wheel joint -->
    <!-- ========================= -->

    <joint name="left_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="left_wheel"/>

        <origin
            xyz="-0.05 ${wheel_separation/2} ${wheel_radius}"
            rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>


    <!-- ========================= -->
    <!-- Right wheel joint -->
    <!-- ========================= -->

    <joint name="right_wheel_joint" type="continuous">

        <parent link="base_link"/>
        <child link="right_wheel"/>

        <origin
            xyz="-0.05 ${-wheel_separation/2} ${wheel_radius}"
            rpy="0 0 0"/>

        <axis xyz="0 1 0"/>

    </joint>

    <!-- ========================= -->
    <!-- CASTOR WHEEL joint -->
    <!-- ========================= -->
    <joint name="caster_joint" type="fixed">
        <parent link="base_link"/>
        <child link="caster_wheel"/>

        <origin
            xyz="${body_length/2 - 0.03} 0 0.015"
            rpy="0 0 0"/>
    </joint>

    <!-- ========================================= -->
    <!-- ros2_control -->
    <!-- ========================================= -->

    <ros2_control name="GazeboSimSystem" type="system">

        <hardware>
            <plugin>gz_ros2_control/GazeboSimSystem</plugin>
        </hardware>

        <!-- Left TT motor -->
        <joint name="left_wheel_joint">

            <command_interface name="velocity"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

        <!-- Right TT motor -->
        <joint name="right_wheel_joint">

            <command_interface name="velocity"/>

            <state_interface name="position"/>
            <state_interface name="velocity"/>

        </joint>

    </ros2_control>


    <!-- ========================================= -->
    <!-- Gazebo ros2_control plugin -->
    <!-- ========================================= -->

    <gazebo>

        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">

            <parameters>
                $(find myrobot_gazebo)/config/controllers.yaml
            </parameters>

        </plugin>

    </gazebo>


</robot>